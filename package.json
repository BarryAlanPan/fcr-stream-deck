{
  "name": "fcr-stream-deck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Direct FlightControlReplay controls for Elgato Stream Deck",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "validate": "streamdeck validate com.local.fcr.sdPlugin",
    "pack": "npm run build && streamdeck pack com.local.fcr.sdPlugin --output dist --force --no-update-check --no-file-list",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1"
  }
}
